# Server Configuration
PORT=8000
PROXY_API_KEY=my-secret-key

# Kiro Region
KIRO_REGION=us-east-1

# ============================================
# Authentication (configure ONE of the following)
# ============================================

# 1. Kiro Desktop (Social Login) - Google, GitHub, Microsoft, etc.
#    Default: ~/.kiro/credentials.json
# KIRO_DESKTOP_CREDS_FILE=~/.kiro/credentials.json

# 2. Enterprise IdC (AWS Identity Center)
#    No default - must be explicitly configured
# KIRO_IDC_CREDS_FILE=~/.aws/sso/cache/kiro-auth-token.json

# 3. kiro-cli (AWS SSO OIDC from SQLite)
#    Default: ~/.kiro-cli/kiro-cli.db
# KIRO_CLI_DB_FILE=~/.kiro-cli/kiro-cli.db

# ============================================
# Usage Tracking
# ============================================

# SQLite database for usage tracking
#    Default: ~/.kiro-proxy/usage.db
# USAGE_DB_FILE=~/.kiro-proxy/usage.db
