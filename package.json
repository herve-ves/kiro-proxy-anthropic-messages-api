{
  "name": "kiro-proxy-anthropic-messages-api",
  "version": "1.0.0",
  "description": "Kiro to Anthropic Messages API Gateway using Bun + Hono + TypeScript",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "bun run src/index.ts serve",
    "dev": "bun run --watch src/index.ts serve",
    "models": "bun run src/index.ts models",
    "credits": "bun run src/index.ts credits",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix"
  },
  "dependencies": {
    "commander": "^14.0.2",
    "hono": "^4.6.0",
    "pino": "^10.2.1",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/bun": "latest",
    "eslint": "^9.39.2",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.53.1"
  },
  "keywords": [
    "kiro",
    "anthropic",
    "claude",
    "api",
    "gateway",
    "proxy"
  ],
  "license": "MIT"
}
